[Unit]
Description=BLE Scale Sync (MorphoScan → Suite scale-ingest)
After=network-online.target bluetooth.service
Wants=network-online.target

[Service]
# Arrancado bajo demanda por suite-ble-ondemand.service al detectar «Pesar».
# Type=notify + WatchdogSec: event loop congelado → systemd mata/reinicia.
# Escaneos async colgados: suite-ble-gateway-watchdog.sh (cron).
Type=notify
NotifyAccess=all
WatchdogSec=120
WatchdogSignal=SIGKILL
TimeoutStartSec=90
WorkingDirectory=/root/renpho-gateway/ble-scale-sync
EnvironmentFile=-/root/renpho-gateway/ble-scale-sync/.env
Environment=CONTINUOUS_MODE=true
Environment=PATH=/root/renpho-gateway/ble-scale-sync/venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/npm start
# on-failure: un `systemctl stop` del ondemand se mantiene parado.
Restart=on-failure
RestartSec=5
# Seguridad si un pesaje deja el proceso vivo demasiado (TTL 5 min + gracia).
RuntimeMaxSec=1800
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

# Sin [Install]/ no se habilita en boot. suite-ble-ondemand lo arranca al «Pesar».
