DEFINE POPUP menúcontex SHORTCUT RELATIVE FROM MROW(),MCOL()
DEFINE BAR 1 OF menúcontex PROMPT "Modificar" ;
	SKIP FOR _SCREEN.activeform.idplanmenu=0
DEFINE BAR 2 OF menúcontex PROMPT "Eliminar" ;
	SKIP FOR _SCREEN.activeform.idplanmenu=0
ON SELECTION BAR 1 OF menúcontex _SCREEN.ACTIVEFORM.seleccionmenu( "Modificar" )
ON SELECTION BAR 2 OF menúcontex _SCREEN.ACTIVEFORM.seleccionmenu( "Eliminar" )

ACTIVATE POPUP menúcontex

