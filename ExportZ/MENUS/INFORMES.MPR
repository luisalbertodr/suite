*

SET SYSMENU TO
SET SYSMENU AUTOMATIC

DEFINE PAD _MSM_FILE OF _MSYSMENU PROMPT "\<Archivo" COLOR SCHEME 3 ;
	NEGOTIATE  LEFT, NONE ;
	KEY ALT+A, "" ;
	MESSAGE "Crea, abre, guarda o imprime archivos, o sale de Visual FoxPro."
DEFINE PAD _MSM_EDIT OF _MSYSMENU PROMPT "\<Edición" COLOR SCHEME 3 ;
	KEY ALT+E, "" ;
	MESSAGE "Modifica texto o la selección actual."
DEFINE PAD _MSM_VIEW OF _MSYSMENU PROMPT "\<Ver" COLOR SCHEME 3 ;
	KEY ALT+V, "" ;
	MESSAGE "Cambia las opciones de presentación."
DEFINE PAD _MSM_WINDO OF _MSYSMENU PROMPT "Ve\<ntana" COLOR SCHEME 3 ;
	NEGOTIATE  RIGHT, NONE ;
	KEY ALT+N, "" ;
	MESSAGE "Manipula ventanas, muestra las ventanas Comandos y Sesión de datos."
ON PAD _MSM_FILE OF _MSYSMENU ACTIVATE POPUP _mfile
ON PAD _MSM_EDIT OF _MSYSMENU ACTIVATE POPUP _medit
ON PAD _MSM_VIEW OF _MSYSMENU ACTIVATE POPUP _mview
ON PAD _MSM_WINDO OF _MSYSMENU ACTIVATE POPUP _mwindow

DEFINE POPUP _mfile MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR _MFI_NEW OF _mfile PROMPT "\<Nuevo..." ;
	KEY CTRL+N, "Ctrl+N" ;
	MESSAGE "Crea un nuevo archivo."
DEFINE BAR _MFI_OPEN OF _mfile PROMPT "\<Abrir..." ;
	KEY CTRL+O, "Ctrl+O" ;
	MESSAGE "Abre un archivo ya existente."
DEFINE BAR _MFI_CLOSE OF _mfile PROMPT "\<Cerrar" ;
	MESSAGE "Cierra el archivo actual."
DEFINE BAR _MFI_CLALL OF _mfile PROMPT "Cerrar todas" ;
	MESSAGE "Cierra todas las ventanas."
DEFINE BAR _MFI_SP100 OF _mfile PROMPT "\-"
DEFINE BAR _MFI_SAVE OF _mfile PROMPT "G\<uardar" ;
	KEY CTRL+S, "Ctrl+S" ;
	MESSAGE "Guarda los cambios realizados al archivo actual."
DEFINE BAR _MFI_SAVAS OF _mfile PROMPT "\<Guardar como..." ;
	MESSAGE "Guarda con un nombre nuevo los cambios realizados al archivo actual."
DEFINE BAR _MFI_REVRT OF _mfile PROMPT "\<Revertir" ;
	MESSAGE "Recupera la última versión guardada del archivo actual."
DEFINE BAR _MFI_SP300 OF _mfile PROMPT "\-"
DEFINE BAR _MFI_PGSET OF _mfile PROMPT "\<Preparar página..." ;
	MESSAGE "Cambia la distribución de página y la configuración de la impresora."
DEFINE BAR _MFI_PREVU OF _mfile PROMPT "Vista preli\<minar" ;
	MESSAGE "Muestra las páginas completas tal y como se imprimirán."
DEFINE BAR _MFI_SYSPRINT OF _mfile PROMPT "\<Imprimir..." ;
	KEY CTRL+P, "Ctrl+P" ;
	MESSAGE "Imprime un archivo de texto, un informe, una etiqueta, el contenido de la ventana Comandos o el Portapapeles."
DEFINE BAR _MFI_SP400 OF _mfile PROMPT "\-"
DEFINE BAR _MFI_QUIT OF _mfile PROMPT "\<Salir" ;
	MESSAGE "Sale de Visual FoxPro"

DEFINE POPUP _medit MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR _MED_UNDO OF _medit PROMPT "\<Deshacer" ;
	KEY CTRL+Z, "Ctrl+Z" ;
	MESSAGE "Deshace el último comando o acción."
DEFINE BAR _MED_REDO OF _medit PROMPT "Re\<hacer" ;
	KEY CTRL+R, "Ctrl+R" ;
	MESSAGE "Repite el último comando o acción."
DEFINE BAR _MED_SP100 OF _medit PROMPT "\-"
DEFINE BAR _MED_CUT OF _medit PROMPT "Cor\<tar" ;
	KEY CTRL+X, "Ctrl+X" ;
	MESSAGE "Quita la selección y la coloca en el Portapapeles."
DEFINE BAR _MED_COPY OF _medit PROMPT "\<Copiar" ;
	KEY CTRL+C, "Ctrl+C" ;
	MESSAGE "Copia la selección al Portapapeles."
DEFINE BAR _MED_PASTE OF _medit PROMPT "Peg\<ar" ;
	KEY CTRL+V, "Ctrl+V" ;
	MESSAGE "Pega el contenido del Portapapeles."
DEFINE BAR _MED_CLEAR OF _medit PROMPT "\<Borrar" ;
	MESSAGE "Quita la selección pero no la coloca en el Portapapeles."
DEFINE BAR _MED_SP200 OF _medit PROMPT "\-"
DEFINE BAR _MED_SLCTA OF _medit PROMPT "\<Seleccionar todo" ;
	KEY CTRL+A, "Ctrl+A" ;
	MESSAGE "Selecciona todos los elementos o texto de la ventana actual."
DEFINE BAR _MED_SP300 OF _medit PROMPT "\-"
DEFINE BAR _MED_PREF OF _medit PROMPT "\<Propiedades..." ;
	MESSAGE "Permite establecer las propiedades del editor."

DEFINE POPUP _mview MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR _MVI_TOOLB OF _mview PROMPT "\<Barra de herramientas..." ;
	MESSAGE "Muestra, oculta o personaliza barras de herramientas."

DEFINE POPUP _mwindow MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR _MWI_ARRAN OF _mwindow PROMPT "\<Organizar todo" ;
	MESSAGE "Organiza las ventanas como mosaicos que no se superponen."
DEFINE BAR _MWI_SP100 OF _mwindow PROMPT "\-"
DEFINE BAR _MWI_HIDE OF _mwindow PROMPT "O\<cultar" ;
	MESSAGE "Oculta la ventana activa."
DEFINE BAR _MWI_HIDEA OF _mwindow PROMPT "Ocultar todo" ;
	MESSAGE "Oculta todas las ventanas."
DEFINE BAR _MWI_SHOWA OF _mwindow PROMPT "\<Mostrar todo" ;
	MESSAGE "Muestra todas las ventanas ocultas."
DEFINE BAR _MWI_CLEAR OF _mwindow PROMPT "\<Borrar" ;
	MESSAGE "Borra el texto del área de trabajo de la aplicación o de la ventana actual."
DEFINE BAR _MWI_ROTAT OF _mwindow PROMPT "\<Recorrer" ;
	KEY CTRL+F1, "Ctrl+F1" ;
	MESSAGE "Recorre todas las ventanas abiertas."
DEFINE BAR _MWI_SP200 OF _mwindow PROMPT "\-"
DEFINE BAR _MWI_VIEW OF _mwindow PROMPT "\<Sesión de datos" ;
	MESSAGE "Muestra la ventana Sesión de datos."
