*       *********************************************************
*       *                                                         
*       *                      Menu Definition                    
*       *                                                         
*       *********************************************************
*

DEFINE POPUP menúcontex SHORTCUT RELATIVE FROM MROW(),MCOL()
DEFINE BAR 1 OF menúcontex PROMPT "Nueva" ;
	SKIP FOR _SCREEN.activeform.idplanmenu<>0
DEFINE BAR 2 OF menúcontex PROMPT "Modificar" ;
	SKIP FOR _SCREEN.activeform.idplanmenu=0
DEFINE BAR 3 OF menúcontex PROMPT "Eliminar" ;
	SKIP FOR _SCREEN.activeform.idplanmenu=0
DEFINE BAR 4 OF menúcontex PROMPT "\-"
DEFINE BAR 5 OF menúcontex PROMPT "Cortar" ;
	SKIP FOR _SCREEN.activeform.idplanmenu=0
DEFINE BAR 6 OF menúcontex PROMPT "Copiar" ;
	SKIP FOR _SCREEN.activeform.idplanmenu=0
DEFINE BAR 7 OF menúcontex PROMPT "Pegar" ;
	SKIP FOR _SCREEN.activeform.idplanmenu=0 .AND.  .NOT. INLIST(UPPER(_SCREEN.activeform.ultimaaccion), "COPIAR", "CORTAR")
ON SELECTION BAR 1 OF menúcontex _SCREEN.ACTIVEFORM.seleccionmenu( "CREAR" )
ON SELECTION BAR 2 OF menúcontex _SCREEN.ACTIVEFORM.seleccionmenu( "Modificar" )
ON SELECTION BAR 3 OF menúcontex _SCREEN.ACTIVEFORM.seleccionmenu( "Eliminar" )
ON SELECTION BAR 5 OF menúcontex _SCREEN.ACTIVEFORM.seleccionmenu( "Cortar" )
ON SELECTION BAR 6 OF menúcontex _SCREEN.ACTIVEFORM.seleccionmenu( "Copiar" )
ON SELECTION BAR 7 OF menúcontex _SCREEN.ACTIVEFORM.seleccionmenu( "Pegar" )

ACTIVATE POPUP menúcontex

