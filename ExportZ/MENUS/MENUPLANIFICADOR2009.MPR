*       *********************************************************
*       *                                                         
*       *                      Menu Definition                    
*       *                                                         
*       *********************************************************
*

DEFINE POPUP menúcontex SHORTCUT RELATIVE FROM MROW(),MCOL()
DEFINE BAR 1 OF menúcontex PROMPT "Nueva Nota" ;
	SKIP FOR _SCREEN.activeform.oformorigen.ntipocelda<>1
DEFINE BAR 2 OF menúcontex PROMPT "Ver Nota" ;
	SKIP FOR _SCREEN.activeform.oformorigen.ntipocelda<>2
DEFINE BAR 3 OF menúcontex PROMPT "Facturar Nota" ;
	SKIP FOR _SCREEN.activeform.oformorigen.ntipocelda<>2
DEFINE BAR 4 OF menúcontex PROMPT "Eliminar Nota" ;
	SKIP FOR _SCREEN.activeform.oformorigen.ntipocelda<>2
DEFINE BAR 5 OF menúcontex PROMPT "\-"
DEFINE BAR 6 OF menúcontex PROMPT "Cortar" ;
	SKIP FOR _SCREEN.activeform.oformorigen.ntipocelda<>2
DEFINE BAR 7 OF menúcontex PROMPT "Copiar" ;
	SKIP FOR _SCREEN.activeform.oformorigen.ntipocelda<>2
DEFINE BAR 8 OF menúcontex PROMPT "Pegar" ;
	SKIP FOR _SCREEN.activeform.oformorigen.ntipocelda<>1 .OR.  .NOT. INLIST(UPPER(_SCREEN.activeform.oformorigen.cultimaaccionmenu), "COPIAR", "CORTAR")
ON SELECTION BAR 1 OF menúcontex _SCREEN.ACTIVEFORM.seleccionmenu( "NUEVA" )
ON SELECTION BAR 2 OF menúcontex _SCREEN.ACTIVEFORM.seleccionmenu( "ver" )
ON SELECTION BAR 3 OF menúcontex _SCREEN.ACTIVEFORM.seleccionmenu( "Facturar" )
ON SELECTION BAR 4 OF menúcontex _SCREEN.ACTIVEFORM.seleccionmenu( "Eliminar" )
ON SELECTION BAR 6 OF menúcontex _SCREEN.ACTIVEFORM.seleccionmenu( "Cortar" )
ON SELECTION BAR 7 OF menúcontex _SCREEN.ACTIVEFORM.seleccionmenu( "Copiar" )
ON SELECTION BAR 8 OF menúcontex _SCREEN.ACTIVEFORM.seleccionmenu( "Pegar" )

ACTIVATE POPUP menúcontex

