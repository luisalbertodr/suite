DEFINE POPUP menúcontex SHORTCUT RELATIVE FROM MROW(),MCOL()
DEFINE BAR 1 OF menúcontex PROMPT "Añadir a Favoritos" ;
	SKIP FOR _SCREEN.activeform.oopcionfavoritos.favorito
DEFINE BAR 2 OF menúcontex PROMPT "Eliminar de Favoritos" ;
	SKIP FOR .NOT. _SCREEN.activeform.oopcionfavoritos.favorito
ON SELECTION BAR 1 OF menúcontex _SCREEN.ACTIVEFORM.addfavoritos()
ON SELECTION BAR 2 OF menúcontex _SCREEN.ACTIVEFORM.delfavoritos()

ACTIVATE POPUP menúcontex

